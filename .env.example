# Copy to .env and fill in real values — never commit .env
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=generate-a-new-one-see-comment-above

# Set to True ONLY for local dev
DJANGO_DEBUG=False

# Comma-separated — your server IP/domain, e.g. 192.168.1.10,monapp.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
