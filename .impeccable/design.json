  "components": [
    {
      "name": "Vendre Button",
      "kind": "button",
      "refersTo": "button-vendre",
      "description": "Sells a ticket; wears the ticket yellow it produces.",
      "html": "<button class=\"ds-btn ds-btn-vendre\">Vendre</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:52px;min-width:108px;padding:0 1rem;border:1px solid transparent;border-radius:var(--radius,4px);font-family:var(--font,system-ui);font-weight:800;font-size:1.02rem;line-height:1;cursor:pointer;transition:filter .15s}.ds-btn:hover{filter:brightness(1.1)}.ds-btn:focus-visible{outline:3px solid var(--focus,#0b4a9e);outline-offset:2px}.ds-btn-vendre{background:var(--ticket,#ffd100);color:var(--ticket-ink,#0d1114)}"
    },
    {
      "name": "Sortir Button",
      "kind": "button",
      "refersTo": "button-sortir",
      "description": "Sends a ticketed boat out; wears sortie blue.",
      "html": "<button class=\"ds-btn ds-btn-sortir\">Sortir</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:52px;min-width:108px;padding:0 1rem;border:1px solid transparent;border-radius:var(--radius,4px);font-family:var(--font,system-ui);font-weight:800;font-size:1.02rem;line-height:1;cursor:pointer;transition:filter .15s}.ds-btn:hover{filter:brightness(1.1)}.ds-btn:focus-visible{outline:3px solid var(--focus,#0b4a9e);outline-offset:2px}.ds-btn-sortir{background:var(--sortie,#0b4a9e);color:var(--sortie-ink,#fff)}"
    },
    {
