# Variables de production. En ligne, ce fichier est env/pontons.env dans nas-stack
# (généré par setup.sh). Pour un test local : copier en .env.production.

# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=generate-a-fresh-key-here

DJANGO_DEBUG=False

# Le domaine public, plus localhost pour la sonde de santé Docker
DJANGO_ALLOWED_HOSTS=pontons.example.com,localhost
