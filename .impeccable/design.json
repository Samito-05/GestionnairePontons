      "description": "Takes a boat back; wears libre green.",
      "html": "<button class=\"ds-btn ds-btn-retour\">Retour</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:52px;min-width:108px;padding:0 1rem;border:1px solid transparent;border-radius:var(--radius,4px);font-family:var(--font,system-ui);font-weight:800;font-size:1.02rem;line-height:1;cursor:pointer;transition:filter .15s}.ds-btn:hover{filter:brightness(1.1)}.ds-btn:focus-visible{outline:3px solid var(--focus,#0b4a9e);outline-offset:2px}.ds-btn-retour{background:var(--libre,#075c2f);color:var(--libre-ink,#fff)}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary and admin actions.",
      "html": "<button class=\"ds-btn-ghost\">Modifier</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;min-height:44px;padding:0 1rem;background:var(--surface,#fff);color:var(--ink,#0d1114);border:1px solid var(--rule-strong,#9aa6af);border-radius:var(--radius,4px);font-family:var(--font,system-ui);font-weight:800;font-size:.95rem;cursor:pointer;transition:background-color .15s,border-color .15s}.ds-btn-ghost:hover{background:var(--surface-2,#f5f7f8);border-color:var(--ink-3,#56616b)}.ds-btn-ghost:focus-visible{outline:3px solid var(--focus,#0b4a9e);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "48px ruled field, focus shifts border and outline to the focus colour.",
      "html": "<input class=\"ds-input\" type=\"text\" placeholder=\"Client (facultatif)\">",
      "css": ".ds-input{width:100%;min-height:48px;padding:.6rem .8rem;background:var(--surface,#fff);color:var(--ink,#0d1114);border:1px solid var(--rule-strong,#9aa6af);border-radius:var(--radius,4px);font-family:var(--font,system-ui);font-size:1rem}.ds-input::placeholder{color:var(--ink-3,#56616b)}.ds-input:hover{border-color:var(--ink-3,#56616b)}.ds-input:focus-visible{outline:3px solid var(--focus,#0b4a9e);outline-offset:0;border-color:var(--focus,#0b4a9e)}"
    },
    {
      "name": "Boat Row (late)",
      "kind": "card",
      "refersTo": "state-plaque-retard",
      "description": "Signature row: state plaque | name + figure | action. Shown in the late state.",
      "html": "<article class=\"ds-tile ds-late\"><div class=\"ds-plaque\"><svg class=\"ds-mark\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"5\" r=\"4.3\"/><circle cx=\"10\" cy=\"15\" r=\"4.3\"/></svg><span>Retard</span></div><div class=\"ds-body\"><strong class=\"ds-name\"><span class=\"ds-chip\" style=\"background:#22c55e\"></span>Kayak Vert</strong><span class=\"ds-fig\">+46 min</span><span class=\"ds-meta\">fin 08:56 · Famille Leroy</span></div><div class=\"ds-act\"><button class=\"ds-btn ds-btn-retour\">Retour</button></div></article>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:52px;min-width:108px;padding:0 1rem;border:1px solid transparent;border-radius:var(--radius,4px);font-family:var(--font,system-ui);font-weight:800;font-size:1.02rem;line-height:1;cursor:pointer;transition:filter .15s}.ds-btn:hover{filter:brightness(1.1)}.ds-btn:focus-visible{outline:3px solid var(--focus,#0b4a9e);outline-offset:2px}.ds-btn-retour{background:var(--libre,#075c2f);color:#fff}.ds-tile{display:grid;grid-template-columns:74px minmax(0,1fr) auto;min-height:72px;background:var(--surface,#fff);border:1px solid var(--rule,#cdd4da);border-radius:4px;overflow:hidden;font-family:var(--font,system-ui)}.ds-tile.ds-late{background:var(--retard-wash,#fde8ea);border:2px solid var(--retard-line,#a50018)}.ds-plaque{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.3rem;font-size:.82rem;font-weight:800;background:var(--retard,#a50018);color:#fff}.ds-mark{width:1.15rem;height:1.15rem;fill:currentColor}.ds-body{padding:.45rem .75rem;display:flex;flex-direction:column;justify-content:center;gap:.1rem;min-width:0}.ds-name{display:flex;align-items:center;gap:.45rem;font-size:1.1rem;font-weight:800}.ds-chip{width:10px;height:10px;border-radius:2px}.ds-fig{font-size:1.25rem;font-weight:800;color:var(--retard-text,#a50018);font-variant-numeric:tabular-nums}.ds-meta{font-size:.92rem;color:var(--ink-2,#3b444c)}.ds-act{display:flex;align-items:center;padding:.6rem .7rem .6rem 0}"
    },
    {
      "name": "State Plaques",
      "kind": "custom",
      "refersTo": "state-plaque-libre",
      "description": "The four buoyage states: colour field + topmark + word.",
      "html": "<div class=\"ds-plaques\"><div class=\"ds-pl ds-pl-libre\"><svg class=\"ds-mark\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M10 2 18.5 17.5h-17z\"/></svg><span>Libre</span></div><div class=\"ds-pl ds-pl-ticket\"><svg class=\"ds-mark\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M3.5 3.5l13 13M16.5 3.5l-13 13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3.6\" stroke-linecap=\"square\"/></svg><span>Ticket</span></div><div class=\"ds-pl ds-pl-sortie\"><svg class=\"ds-mark\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"10\" r=\"7.5\"/></svg><span>Sorti</span></div><div class=\"ds-pl ds-pl-retard\"><svg class=\"ds-mark\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"5\" r=\"4.3\"/><circle cx=\"10\" cy=\"15\" r=\"4.3\"/></svg><span>Retard</span></div></div>",
      "css": ".ds-plaques{display:flex;gap:2px;font-family:var(--font,system-ui)}.ds-pl{width:74px;height:72px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.3rem;font-size:.82rem;font-weight:800}.ds-mark{width:1.15rem;height:1.15rem;fill:currentColor}.ds-pl-libre{background:#075c2f;color:#fff}.ds-pl-ticket{background:#ffd100;color:#0d1114}.ds-pl-sortie{background:#0b4a9e;color:#fff}.ds-pl-retard{background:#a50018;color:#fff}"
    },
    {
      "name": "Filter Bar",
      "kind": "chip",
      "refersTo": "filter-active",
      "description": "Five ruled cells, count over mark + label; pressed cell inverts, Retards alarms red.",
      "html": "<div class=\"ds-filters\"><button class=\"ds-f\" aria-pressed=\"true\"><strong>10</strong><span>Tous</span></button><button class=\"ds-f\" aria-pressed=\"false\"><strong>0</strong><span><svg class=\"ds-mark ds-g\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M10 2 18.5 17.5h-17z\"/></svg>Libres</span></button><button class=\"ds-f ds-alert\" aria-pressed=\"false\"><strong>1</strong><span><svg class=\"ds-mark ds-r\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"5\" r=\"4.3\"/><circle cx=\"10\" cy=\"15\" r=\"4.3\"/></svg>Retards</span></button></div>",
      "css": ".ds-filters{display:grid;grid-template-columns:repeat(3,1fr);background:var(--surface,#fff);border:1px solid var(--rule,#cdd4da);font-family:var(--font,system-ui)}.ds-f{min-height:60px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.1rem;background:none;border:0;border-left:1px solid var(--rule,#cdd4da);color:var(--ink,#0d1114);cursor:pointer}.ds-f:first-child{border-left:0}.ds-f strong{font-size:1.45rem;font-weight:800;line-height:1}.ds-f span{display:flex;align-items:center;gap:.3rem;font-size:.84rem;font-weight:700;color:var(--ink-2,#3b444c)}.ds-mark{width:.85rem;height:.85rem;fill:currentColor}.ds-g{color:#075c2f}.ds-r{color:#a50018}.ds-f:hover{background:var(--surface-2,#f5f7f8)}.ds-f[aria-pressed=true]{background:var(--ink,#0d1114);color:var(--surface,#fff)}.ds-f[aria-pressed=true] span{color:inherit}.ds-alert strong{color:var(--retard-text,#a50018)}.ds-f:focus-visible{outline:3px solid var(--focus,#0b4a9e);outline-offset:2px}"
    },
    {
      "name": "Top Bar",
      "kind": "nav",
      "refersTo": "topbar",
      "description": "Black shell bar; current item white with a 3px signal-yellow underline.",
      "html": "<nav class=\"ds-bar\"><span class=\"ds-brand\">La Plage<small>L'Isle-Adam</small></span><a class=\"ds-nav\" aria-current=\"page\" href=\"#\">Sorties</a><a class=\"ds-nav\" href=\"#\">Planning</a></nav>",
      "css": ".ds-bar{display:flex;align-items:stretch;height:56px;background:var(--shell,#0d1114);color:#fff;font-family:var(--font,system-ui);padding-left:1.5rem;gap:1.5rem}.ds-brand{align-self:center;font-weight:800;font-size:1.06rem;line-height:1.1}.ds-brand small{display:block;font-weight:500;font-size:.78rem;color:var(--shell-ink-2,#b8c2ca)}.ds-nav{display:flex;align-items:center;padding:0 1rem;color:var(--shell-ink-2,#b8c2ca);font-weight:700;font-size:.95rem;text-decoration:none;box-shadow:inset 0 -3px 0 transparent}.ds-nav:hover{color:#fff;background:var(--shell-2,#20272d)}.ds-nav[aria-current=page]{color:#fff;box-shadow:inset 0 -3px 0 var(--signal,#ffd100)}.ds-nav:focus-visible{outline:3px solid var(--signal,#ffd100);outline-offset:-3px}"
    },
    {
      "name": "Late Band",
      "kind": "custom",
      "refersTo": "late-band",
